# Copy this file to .env and fill it in. Never commit .env
SECRET_KEY=change-me-use-a-long-random-string
DATABASE_URL=sqlite:///./edunexus.db

# ---- Free AI (add at least ONE key; takes 2 minutes, no card) ----
# Gemini: https://aistudio.google.com/apikey      Groq: https://console.groq.com/keys      OpenRouter: https://openrouter.ai/keys
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
AI_PROVIDER=auto
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Optional: local Ollama (only used if it is running)
OLLAMA_URL=http://localhost:11434
DEFAULT_MODEL=llama3.2

# Lets you read all user feedback at /api/admin/feedback?key=THIS_VALUE
ADMIN_KEY=
TOKEN_EXPIRE_MINUTES=43200
